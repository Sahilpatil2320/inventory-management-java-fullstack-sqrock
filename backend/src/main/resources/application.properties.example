# Copy the values below into environment variables (recommended) or into an
# untracked application-local.properties file. NEVER commit real secrets.
#
# Windows PowerShell (current session only):
#   $env:DB_PASSWORD = "your-mysql-app-password"
#   $env:JWT_SECRET = "a-random-string-of-at-least-32-characters"
#   $env:INITIAL_ADMIN_EMAIL = "admin@yourcompany.com"
#   $env:INITIAL_ADMIN_PASSWORD = "choose-a-strong-password"

DB_URL=jdbc:mysql://localhost:3306/inventory_management?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
DB_USERNAME=inventory_app
DB_PASSWORD=<your-mysql-app-user-password>

JWT_SECRET=<random-string-min-32-characters>
JWT_EXPIRATION_MINUTES=480

CORS_ALLOWED_ORIGINS=http://localhost:5173
SERVER_PORT=8080

# Only used when the users table is empty
INITIAL_ADMIN_NAME=Administrator
INITIAL_ADMIN_EMAIL=<admin-email>
INITIAL_ADMIN_PASSWORD=<strong-password-min-10-characters>
